{
  "info": {
    "name": "Bank API - Endpoints Tests",
    "_postman_id": "bank-api-endpoints-tests",
    "description": "Colección importable en Postman con los casos definidos en pruebas_endpoints.json",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8083" },
    { "key": "token", "value": "" },
    { "key": "clientDocument", "value": "983920394" },
    { "key": "newClientDocument", "value": "1098765432" },
    { "key": "loanIdApprove", "value": "1001" },
    { "key": "loanIdReject", "value": "1002" }
  ],
  "item": [
    {
      "name": "Auth - Login (obtener token)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{ \"username\": \"ADMINISTRATOR\", \"password\": \"123\" }"
        },
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var json = pm.response.json();",
              "if (json && json.token) { pm.environment.set('token', 'Bearer ' + json.token); }",
              "pm.test('token saved', function () { pm.expect(pm.environment.get('token')).to.exist; });"
            ]
          }
        }
      ]
    },
    {
